# Copie para .env e preencha. Na Vercel, cadastre as mesmas variáveis em Project Settings > Environment Variables.

# Endereço do projeto no Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA do Supabase (sb_publishable_... ou a "anon"). Nunca a chave secreta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
